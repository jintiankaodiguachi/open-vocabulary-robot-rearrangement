<?xml version="1.0"?>
<package format="3">
  <name>open_vocab_task_manager</name>
  <version>0.2.4</version>
  <description>Transactional action-based task orchestration for open-vocabulary Kinova rearrangement.</description>
  <maintainer email="hao@example.com">hao</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>open_vocab_interfaces</exec_depend>
  <exec_depend>open_vocab_observer</exec_depend>
  <exec_depend>open_vocab_local_perception</exec_depend>
  <exec_depend>open_vocab_grasp_planner</exec_depend>
  <exec_depend>open_vocab_manipulation</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
